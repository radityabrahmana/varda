{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "office-js", "office-runtime", "react", "react-dom"],
    "paths": {
      "@varda/contracts": ["../packages/contracts/index.d.ts"],
      "react": [
        "./node_modules/@types/react/index.d.ts"
      ],
      "react/jsx-runtime": [
        "./node_modules/@types/react/jsx-runtime.d.ts"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom/index.d.ts"
      ],
      "lucide-react": [
        "./node_modules/lucide-react"
      ],
      "clsx": [
        "./node_modules/clsx"
      ],
      "tailwind-merge": [
        "./node_modules/tailwind-merge"
      ],
      "@radix-ui/react-dropdown-menu": [
        "./node_modules/@radix-ui/react-dropdown-menu"
      ],
      "@varda/edit-card-ui": [
        "../frontend/src/shared/ui/EditCardUI.tsx"
      ],
      "@varda/edit-cards-section-ui": [
        "../frontend/src/shared/ui/EditCardsSectionUI.tsx"
      ],
      "@varda/pre-response-wrapper-ui": [
        "../frontend/src/shared/ui/PreResponseWrapperUI.tsx"
      ],
      "@varda/document-event-blocks-ui": [
        "../frontend/src/shared/ui/DocumentEventBlocksUI.tsx"
      ],
      "@varda/glass-card-ui": [
        "../frontend/src/shared/ui/GlassCardUI.tsx"
      ],
      "@varda/modal-ui": [
        "../frontend/src/shared/ui/ModalUI.tsx"
      ],
      "@varda/header-buttons-ui": [
        "../frontend/src/shared/ui/HeaderButtonsUI.tsx"
      ],
      "@varda/pill-button-ui": [
        "../frontend/src/shared/ui/PillButtonUI.tsx"
      ],
      "@varda/tab-pill-button-ui": [
        "../frontend/src/shared/ui/TabPillButtonUI.tsx"
      ],
      "@varda/toggle-switch-ui": [
        "../frontend/src/shared/ui/ToggleSwitchUI.tsx"
      ],
      "@varda/dropdown-ui": [
        "../frontend/src/shared/ui/DropdownUI.tsx"
      ],
      "@varda/citation-pill-ui": [
        "../frontend/src/shared/ui/CitationPillUI.tsx"
      ],
      "@varda/model-toggle-ui": [
        "../frontend/src/shared/ui/ModelToggleUI.tsx"
      ],
      "@varda/brand-icon-ui": [
        "../frontend/src/shared/ui/VardaIconUI.tsx"
      ],
      "@varda/google-icon-ui": [
        "../frontend/src/shared/ui/GoogleIconUI.tsx"
      ],
      "@varda/auth-styles-ui": [
        "../frontend/src/shared/ui/AuthStylesUI.ts"
      ],
      "@varda/auth-divider-ui": [
        "../frontend/src/shared/ui/AuthDividerUI.tsx"
      ],
      "@varda/workflow-slash-command-ui": [
        "../frontend/src/shared/ui/WorkflowSlashCommandUI.tsx"
      ],
      "@varda/upload-session-client": [
        "../frontend/src/shared/api/uploadSessionClient.ts"
      ],
      "@varda/secure-uuid": [
        "../frontend/src/shared/lib/secureUuid.ts"
      ]
    },
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": false,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src"]
}
